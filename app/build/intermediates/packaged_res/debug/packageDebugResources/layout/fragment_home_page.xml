<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_cream">

    <!--view saved artifacts-->
    <Button
        android:id="@+id/buttonSavedArtifacts"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="saved artifacts"
        android:textStyle="bold"
        android:layout_marginTop="20dp"
        android:backgroundTint="@color/brown_medium"
        />

    <!--add artifact-->
    <Button
        android:id="@+id/buttonAddArtifact"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="add artifact"
        android:textStyle="bold"
        android:layout_marginTop="20dp"
        android:backgroundTint="@color/brown_medium"
        />

    <!--search-->
    <EditText
        android:id="@+id/editTextSearch"
        android:hint="using key word to search"
        android:textColor="#402410"
        android:layout_width="0dp"
        android:layout_height="48dp"/>

    <Button
        android:id="@+id/buttonSearch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="search"
        android:textStyle="bold"
        android:layout_marginTop="20dp"
        android:backgroundTint="@color/brown_medium"
        />

    <!--logout-->
    <Button
        android:id="@+id/buttonLogout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="logout"
        android:textStyle="bold"
        android:layout_marginTop="20dp"
        android:backgroundTint="@color/brown_medium"
        />

    <!--all artifacts (navigation)-->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvBrowseArtifacts"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:clipToPadding="false"
        android:paddingBottom="16dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        tools:listitem="@layout/artifacts_display_cards" />

</androidx.constraintlayout.widget.ConstraintLayout>