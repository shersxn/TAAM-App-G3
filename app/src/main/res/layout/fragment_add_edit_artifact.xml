<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EDE5D4">

    <ImageButton
        android:id="@+id/artifactImageButton"
        android:layout_width="151dp"
        android:layout_height="145dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="9dp"
        android:background="#D5D1D1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textViewArtifactImage"
        app:layout_constraintVertical_bias="0.0"
        app:srcCompat="@android:drawable/ic_menu_gallery"
        tools:srcCompat="@android:drawable/ic_menu_gallery" />

    <TextView
        android:id="@+id/textViewMaterial"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="17dp"
        android:text="Material:"
        android:textColor="#402410"
        android:textSize="16sp"
        app:layout_constraintTop_toBottomOf="@id/spinnerCategory"
        app:layout_constraintStart_toStartOf="@id/textViewLotNumber" />

    <TextView
        android:id="@+id/textViewDynastyPeriod"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="17dp"
        android:text="Dynasty / Period:"
        android:textColor="#402410"
        android:textSize="16sp"
        app:layout_constraintTop_toBottomOf="@id/spinnerMaterial"
        app:layout_constraintStart_toStartOf="@id/textViewLotNumber" />

    <TextView
        android:id="@+id/textViewCategory"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="17dp"
        android:text="Category:"
        android:textColor="#402410"
        android:textSize="16sp"
        app:layout_constraintTop_toBottomOf="@id/editTextDescription"
        app:layout_constraintStart_toStartOf="@id/textViewLotNumber" />

    <EditText
        android:id="@+id/editTextDescription"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ems="10"
        android:hint="Enter description..."
        android:inputType="text"
        android:textColor="#908D8C"
        android:textSize="16sp"
        app:layout_constraintTop_toBottomOf="@id/textViewDescription"
        app:layout_constraintStart_toStartOf="@id/textViewLotNumber" />

    <TextView
        android:id="@+id/textViewDescription"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="17dp"
        android:text="Description:"
        android:textColor="#402410"
        android:textSize="16sp"
        app:layout_constraintTop_toBottomOf="@id/editTextName"
        app:layout_constraintStart_toStartOf="@id/textViewLotNumber" />

    <EditText
        android:id="@+id/editTextName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ems="10"
        android:hint="Enter artifact name..."
        android:inputType="text"
        android:textColor="#908D8C"
        android:textSize="16sp"
        app:layout_constraintTop_toBottomOf="@id/textViewName"
        app:layout_constraintStart_toStartOf="@id/textViewLotNumber" />

    <TextView
        android:id="@+id/textViewName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="17dp"
        android:text="Artifact name:"
        android:textColor="#402410"
        android:textSize="16sp"
        app:layout_constraintTop_toBottomOf="@id/editTextLotNumber"
        app:layout_constraintStart_toStartOf="@id/textViewLotNumber" />

    <EditText
        android:id="@+id/editTextLotNumber"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:ems="10"
        android:hint="Enter lot number..."
        android:inputType="text"
        android:textColor="#908D8C"
        android:textSize="16sp"
        app:layout_constraintTop_toBottomOf="@id/textViewLotNumber"
        app:layout_constraintStart_toStartOf="@id/textViewLotNumber"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/textViewLotNumber"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:layout_marginStart="25dp"
        android:text="Lot number:"
        android:textColor="#402410"
        android:textSize="16sp"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toEndOf="@id/artifactImageButton"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintVertical_bias="1.0" />

    <TextView
        android:id="@+id/textViewArtifactImage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Artifact image:"
        android:textColor="#402410"
        android:textSize="16sp"
        app:layout_constraintStart_toStartOf="@id/artifactImageButton"
        app:layout_constraintTop_toTopOf="@id/textViewLotNumber" />

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="100dp"
        android:background="#a47e5a"
        android:minHeight="?attr/actionBarSize"
        android:theme="?attr/actionBarTheme"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.0" />

    <TextView
        android:id="@+id/textViewHeader"
        android:layout_width="270dp"
        android:layout_height="48dp"
        android:layout_marginStart="70dp"
        android:layout_marginTop="31dp"
        android:gravity="center"
        android:text="Add / Edit Artifact"
        android:textColor="#EDE5D4"
        android:textSize="30sp"
        app:layout_constraintBottom_toBottomOf="@id/toolbar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/toolbar"
        app:layout_constraintVertical_bias="0.0" />

    <Button
        android:id="@+id/buttonDone"
        android:layout_width="122dp"
        android:layout_height="57dp"
        android:layout_marginStart="245dp"
        android:layout_marginEnd="25dp"
        android:layout_marginTop="25dp"
        android:layout_marginBottom="25dp"
        android:backgroundTint="#a47e5a"
        android:text="Done"
        android:textAlignment="center"
        android:textSize="20sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/spinnerDynastyPeriod"
        app:strokeColor="#A47E5A" />

    <Spinner
        android:id="@+id/spinnerCategory"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:spinnerMode="dropdown"
        app:layout_constraintTop_toBottomOf="@id/textViewCategory"
        app:layout_constraintStart_toStartOf="@id/textViewLotNumber" />

    <Spinner
        android:id="@+id/spinnerMaterial"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:spinnerMode="dropdown"
        app:layout_constraintTop_toBottomOf="@id/textViewMaterial"
        app:layout_constraintStart_toStartOf="@id/textViewLotNumber" />

    <Spinner
        android:id="@+id/spinnerDynastyPeriod"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        app:layout_constraintBottom_toTopOf="@id/buttonDone"
        app:layout_constraintStart_toStartOf="@id/textViewLotNumber"
        app:layout_constraintTop_toBottomOf="@id/textViewDynastyPeriod" />

</androidx.constraintlayout.widget.ConstraintLayout>
